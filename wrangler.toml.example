# Copy to wrangler.toml (gitignored — stays local) and fill in your KV id:
#   cp wrangler.toml.example wrangler.toml
#   npx wrangler kv namespace create ANTIFEED_KV   # or: npx wrangler kv namespace list
name = "antifeed"
pages_build_output_dir = "site"
compatibility_date = "2026-07-01"

# AF_TOKEN secret is set via: npx wrangler pages secret put AF_TOKEN --project-name antifeed
# (secrets attach at deploy time — redeploy after changing)
[[kv_namespaces]]
binding = "ANTIFEED_KV"
id = "YOUR_KV_NAMESPACE_ID"
